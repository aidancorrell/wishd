# wish:d local configuration. Copy to .env, then run make env to generate a token.
# Keep real credentials out of version control. WISHD_* is preferred; DATASPINE_*
# remains supported. Do not set both forms of the same setting.
WISHD_API_TOKENS=

# Local demo only. Use a dedicated random password before initializing a shared DB.
WISHD_POSTGRES_PASSWORD=dataspine
WISHD_PORT=8080
WISHD_PG_PORT=5432

# make up or make dev-db writes the correct database URL for its backend.
# WISHD_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional settings; Compose requires forwarding these in a local override.
# WISHD_BASE_URL=https://wishd.example.com
# WISHD_ARTIFACT_S3_BUCKET=your-private-bucket
# WISHD_SLACK_BOT_TOKEN=
# WISHD_SLACK_CHANNEL=#data-alerts
# WISHD_SLACK_ROUTES=monitors/slack.yml
# WISHD_INGEST_ASYNC=false
